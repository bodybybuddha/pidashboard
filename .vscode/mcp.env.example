# Copy required values into your shell environment before launching VS Code.

# GitHub MCP
GITHUB_PERSONAL_ACCESS_TOKEN=

# Home Assistant MCP
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# SSH MCP
SSH_MCP_HOST=
SSH_MCP_PORT=22
SSH_MCP_USER=
SSH_MCP_KEY_PATH=~/.ssh/id_rsa

# Langfuse Observability MCP
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Dynatrace Observability MCP
DYNATRACE_BASE_URL=
DYNATRACE_API_TOKEN=
