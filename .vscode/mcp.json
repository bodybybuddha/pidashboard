{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "home-assistant": {
      "command": "npx",
      "args": [
        "-y",
        "home-mcp"
      ],
      "env": {
        "HOME_ASSISTANT_URL": "${env:HOME_ASSISTANT_URL}",
        "HOME_ASSISTANT_TOKEN": "${env:HOME_ASSISTANT_TOKEN}"
      }
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@hypnosis/docker-mcp-server"
      ]
    },
    "ssh": {
      "command": "npx",
      "args": [
        "-y",
        "@idletoaster/ssh-mcp-server"
      ],
      "env": {
        "SSH_MCP_HOST": "${env:SSH_MCP_HOST}",
        "SSH_MCP_PORT": "${env:SSH_MCP_PORT}",
        "SSH_MCP_USER": "${env:SSH_MCP_USER}",
        "SSH_MCP_KEY_PATH": "${env:SSH_MCP_KEY_PATH}"
      }
    },
    "observability-langfuse": {
      "command": "npx",
      "args": [
        "-y",
        "langfuse-observability-mcp-server"
      ],
      "env": {
        "LANGFUSE_HOST": "${env:LANGFUSE_HOST}",
        "LANGFUSE_PUBLIC_KEY": "${env:LANGFUSE_PUBLIC_KEY}",
        "LANGFUSE_SECRET_KEY": "${env:LANGFUSE_SECRET_KEY}"
      }
    },
    "observability-dynatrace": {
      "command": "npx",
      "args": [
        "-y",
        "@dynatrace-oss/dynatrace-mcp-server"
      ],
      "env": {
        "DYNATRACE_BASE_URL": "${env:DYNATRACE_BASE_URL}",
        "DYNATRACE_API_TOKEN": "${env:DYNATRACE_API_TOKEN}"
      }
    },
    "security-scanner": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-security-scanner"
      ]
    }
  }
}
